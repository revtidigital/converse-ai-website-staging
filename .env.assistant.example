# Frontend-safe assistant vars (VITE_ = shipped to browser; NEVER a secret here).
VITE_ASSISTANT_ENABLED=true
# Explicit gateway URL. Append /v1/realtime exactly once. Must be a persistent
# WS host (Render/Railway/Fly/VPS) — NOT the Vercel frontend domain.
VITE_ASSISTANT_GATEWAY_URL=wss://assistant-gateway.onrender.com/v1/realtime
# Optional direct text endpoint (fallback when WS is down).
VITE_ASSISTANT_TEXT_ENDPOINT=https://assistant-service.onrender.com/v1/assistant/respond
