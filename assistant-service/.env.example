# assistant-service — backend ONLY secrets. Deploy on Render/Railway/Fly/VPS.
PORT=8787
# Supabase (staging project). Service-role key is REQUIRED for ingestion + memory writes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__set_in_host_dashboard__
SUPABASE_ANON_KEY=__anon_key__
# Embeddings (self-hosted, no cost)
ASSISTANT_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
ASSISTANT_EMBEDDING_DIMENSION=384
ASSISTANT_EMBEDDING_VERSION=1
# Confidence thresholds — CALIBRATE to the model (see assistant/README).
ASSISTANT_HIGH_THRESHOLD=0.52
ASSISTANT_MEDIUM_THRESHOLD=0.40
ASSISTANT_RETRIEVAL_COUNT=5
# Synthesis: "extractive" = zero-cost self-hosted brain (default, no LLM key).
ASSISTANT_LLM_PROVIDER=extractive
# Memory
ASSISTANT_MEMORY_STORE=supabase
ASSISTANT_SESSION_TTL_SECONDS=1800
# Internal auth from the gateway
ASSISTANT_INTERNAL_GATEWAY_TOKEN=__long_random_shared_secret__
# CORS
ALLOWED_ORIGINS=https://staging.theconverseai.com,http://localhost:5173
