# ConverseAI Self-Hosted Voice Server — Environment Variables
# Copy this file to .env and fill in your values

# ─── Local Ollama LLM ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b

# ─── Speech-to-Text ──────────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
STT_MODEL=base

# ─── Text-to-Speech ──────────────────────────────────────────────────────────
# cosyvoice2  → CosyVoice2 (Qwen2.5-0.5B backbone) — best quality, needs setup
# edge-tts    → Microsoft Neural Voice — good quality, needs internet
# pyttsx3     → offline basic fallback
TTS_ENGINE=cosyvoice2

# ─── CosyVoice2 Setup (only needed if TTS_ENGINE=cosyvoice2) ─────────────────
# Path to cloned CosyVoice repo (relative to voice_server/)
COSYVOICE_PATH=./CosyVoice
# Path to downloaded model weights
COSYVOICE_MODEL_DIR=./CosyVoice/pretrained_models/CosyVoice2-0.5B

# ─── Network & Security ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Add your frontend dev URL here (Vite default: 5173, production domain)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:5173
API_SECRET_TOKEN=converseai-local-secret-key
X_ADMIN_SECRET_KEY=converseai-superadmin-secret-key

# ─── Audio Limits ─────────────────────────────────────────────────────────────
MAX_AUDIO_CHUNK_BYTES=1048576
MAX_AUDIO_DURATION_SEC=30
RATE_LIMIT_PER_MINUTE=60
VAD_THRESHOLD=0.5

# ─── RAG & Privacy ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
ENABLE_AUDIT_LOGS=true
SAVE_AUDIO_TO_DISK=false
